# ─────────────────────────────────────────────────────────────────────────────
# V.app environment variables. Copy to .env.local for local work.
# NEVER commit real values. In production set these in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# "production" for real elections. "test" enables the fictional-data tools (test mailbox, /dev/inbox, seed script).
APP_MODE=test
# Public base URL (https:// required in production). Used in emails and share links.
APP_URL=http://localhost:3000

# Runtime connection — the least-privilege role `vapp_app` (created by `npm run db:roles`).
# Supabase: use the transaction pooler (port 6543). Neon: use the pooled connection string.
DATABASE_URL=postgres://vapp_app:CHANGE_ME@localhost:5432/vapp
# Schema-owner connection — used ONLY by migration/seed/bootstrap scripts. Do NOT set this in Vercel.
DATABASE_OWNER_URL=postgres://postgres:CHANGE_ME@localhost:5432/vapp
# Password assigned to vapp_app by `npm run db:roles` (16+ chars). Not needed at runtime.
APP_DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Optional: max connections per serverless instance (default 5).
# DB_POOL_MAX=5

# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HMAC_SECRET=CHANGE_ME_32+_RANDOM_CHARACTERS
ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
CRON_SECRET=CHANGE_ME_RANDOM_TOKEN

# Email (OPTIONAL) — https://resend.com. Without it, invite/reset links are shown on screen and voters
# still verify with email + student ID.
RESEND_API_KEY=
EMAIL_FROM="V.app <elections@your-domain.example>"

# Optional bot challenge (Cloudflare Turnstile), shown only on suspicious request volume.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
