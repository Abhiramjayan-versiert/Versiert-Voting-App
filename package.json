{
  "name": "vapp",
  "version": "1.0.0",
  "private": true,
  "description": "V.app — secure digital elections for colleges and student unions",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:roles": "tsx --env-file-if-exists=.env.local scripts/setup-roles.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed-dev.ts",
    "bootstrap:superadmin": "tsx --env-file-if-exists=.env.local scripts/bootstrap-superadmin.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "db:setup": "npm run db:roles && npm run db:migrate",
    "cron:local": "tsx --env-file-if-exists=.env.local scripts/run-cron.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@node-rs/argon2": "^2.2.2",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "geist": "^1.8.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
